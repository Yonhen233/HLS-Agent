{
  "task_type": "model",
  "name": "mnist_recognition_mlp",
  "model_path": "models/mnist_recognition/mnist_mlp_trained.onnx",
  "frontend": "onnx",
  "input_shape": [
    784
  ],
  "target": {
    "backend": "Vivado",
    "part": "xc7z020clg400-1",
    "clock_period": 10
  },
  "hls4ml": {
    "precision": "fixed<12,6>",
    "reuse_factor": 512,
    "strategy": "Resource"
  },
  "reference_data": {
    "input_path": "models/mnist_recognition/mnist_test_inputs_20.dat",
    "labels_path": "models/mnist_recognition/mnist_test_labels_20.json",
    "num_samples": 20,
    "seed": 7,
    "tolerance": 0.25,
    "classification_min_accuracy": 0.9,
    "argmax_match_min": 0.95
  },
  "objective": "balanced",
  "demo": {
    "expected_path": "hls4ml",
    "mock_tools": false,
    "description": "Real MNIST digit-recognition demo: trained MLP weights are converted to HLS, Vivado csim compares HLS logits with ONNX reference logits, and summary reports classification accuracy."
  }
}
